{
  "name": "pundi",
  "version": "8.8.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "desktop:start": "npm run build && electron desktop/main.cjs",
    "desktop:dist": "npm run build && electron-builder --win portable",
    "desktop:dist:manual": "npm run build && node scripts/package-windows-manual.mjs",
    "test:desktop": "node tests/integration/desktop-contract.mjs",
    "test:v32": "node tests/integration/v32-refinement-contract.mjs",
    "test:market-data": "node tests/integration/market-data-contract.mjs",
    "test:reviewer-regression": "node tests/integration/reviewer-regression-contract.mjs",
    "audit:market-data": "node scripts/audit-public-providers.mjs",
    "probe:market-data": "node scripts/live-market-data-probe.mjs",
    "preview": "vite preview",
    "brand:assets": "python scripts/generate-brand-assets.py",
    "check": "node scripts/check.mjs && node scripts/check-telegram.mjs",
    "supabase:pundi": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/pundi-supabase.ps1",
    "beta:status": "node scripts/beta-status.mjs",
    "growth:status": "node scripts/growth-status.mjs",
    "test:marketing": "node tests/integration/marketing-contract.mjs",
    "test:acquisition": "node tests/integration/acquisition-contract.mjs",
    "test:metric-semantics": "node tests/integration/metric-semantics-contract.mjs",
    "test:isolation": "node tests/integration/supabase-isolation.mjs",
    "test:admin": "node tests/integration/admin-contract.mjs",
    "test:admin-loading": "node tests/integration/admin-loading-contract.mjs",
    "test:admin-render": "node tests/integration/admin-render-contract.mjs",
    "test:feedback": "node tests/integration/feedback-contract.mjs",
    "test:admin-smoke": "node tests/integration/admin-production-smoke.mjs",
    "test:account-lifecycle": "node tests/integration/account-lifecycle-contract.mjs",
    "test:account-lifecycle-integration": "node tests/integration/account-lifecycle-integration.mjs",
    "test:password-recovery": "node tests/integration/password-recovery-contract.mjs",
    "test:productization-v2": "node tests/integration/productization-v2-contract.mjs",
    "test:entitlement": "node tests/integration/entitlement-resolver-contract.mjs",
    "test:backup-security": "node tests/integration/backup-security-contract.mjs",
    "test:sync-races": "node tests/integration/sync-races-contract.mjs",
    "test:api-contract": "node tests/integration/api-contract.mjs",
    "test:responsive": "node tests/integration/responsive-contract.mjs",
    "test:a11y": "node tests/integration/a11y-contract.mjs",
    "test:domains": "node tests/integration/public-launch-contract.mjs",
    "test:empty-states": "node tests/integration/empty-state-contract.mjs",
    "test:double-submit": "node tests/integration/double-submit-contract.mjs",
    "test:build-identity": "node tests/integration/build-identity-contract.mjs",
    "test:health-v3": "node tests/integration/production-health-v3.mjs",
    "test:user-smoke": "node tests/integration/user-production-smoke.mjs",
    "test:authz-production": "node tests/integration/authz-production.mjs",
    "test:identity": "node tests/integration/identity-drift-contract.mjs",
    "test:commerce": "node tests/integration/commerce-contract.mjs",
    "commerce:reconcile": "node scripts/commerce-reconcile.mjs",
    "test:android": "node tests/integration/android-contract.mjs",
    "test:legal-support": "node tests/integration/legal-support-contract.mjs",
    "android:sync": "npm run build && node scripts/prepare-android-web.mjs && npx cap sync android",
    "android:apk": "npm run android:sync && node scripts/android-signing.mjs && node scripts/run-android-gradle.mjs && node scripts/collect-android-apk.mjs",
    "test:backup-filename": "node tests/integration/backup-filename-contract.mjs",
    "test:cvfinance-isolation": "node scripts/test-cvfinance-isolation.mjs",
    "test:health-v4": "node tests/integration/production-health-v3.mjs && npm run test:authz-production",
    "test:production": "npm run test:health-v4 && npm run test:user-smoke && npm run test:admin-smoke",
    "test:core": "npm run test:productization-v2 && npm run test:entitlement && npm run test:backup-security && npm run test:backup-filename && npm run test:cvfinance-isolation && npm run test:sync-races && npm run test:api-contract",
    "test:browser": "npm run test:responsive && npm run test:a11y",
    "test:all": "npm run test:core && npm run test:browser && npm run test:identity && npm run test:regression && npm run check && npm run build",
    "test:regression": "npm run test:productization-v2 && npm run test:entitlement && npm run test:backup-security && npm run test:backup-filename && npm run test:sync-races && npm run test:api-contract && npm run test:empty-states && npm run test:double-submit && npm run test:build-identity && npm run test:password-recovery && npm run test:account-lifecycle && npm run test:admin && npm run test:admin-loading && npm run test:admin-render && npm run test:isolation && npm run test:reviewer-regression"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "^2.55.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "axe-core": "^4.13.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "online.pundi.desktop",
    "productName": "Pundi",
    "asar": true,
    "directories": { "output": "artifacts/windows-v32" },
    "files": ["dist/**/*", "desktop/**/*", "package.json"],
    "win": {
      "icon": "desktop/pundi.ico",
      "target": [{ "target": "portable", "arch": ["x64"] }]
    },
    "portable": {
      "artifactName": "Pundi-${version}-Windows-x64.exe"
    }
  }
}
