{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/refresh-stocks",
      "schedule": "15 23 * * 1-5"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.pundi.online" }],
      "destination": "https://pundi.online/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/stocks/fx",
      "destination": "/api/stocks/quote?__route=fx"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "app.pundi.online" }],
      "destination": "/app.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "pundi.online" }],
      "destination": "/landing.html"
    },
    {
      "source": "/privacy",
      "has": [{ "type": "host", "value": "pundi.online" }],
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "has": [{ "type": "host", "value": "pundi.online" }],
      "destination": "/terms.html"
    },
    {
      "source": "/support",
      "has": [{ "type": "host", "value": "pundi.online" }],
      "destination": "/support.html"
    },
    {
      "source": "/updates",
      "has": [{ "type": "host", "value": "pundi.online" }],
      "destination": "/updates.html"
    },
    { "source": "/catatan-keuangan", "has": [{ "type": "host", "value": "pundi.online" }], "destination": "/catatan-keuangan.html" },
    { "source": "/pencatat-pengeluaran", "has": [{ "type": "host", "value": "pundi.online" }], "destination": "/pencatat-pengeluaran.html" },
    { "source": "/budgeting", "has": [{ "type": "host", "value": "pundi.online" }], "destination": "/budgeting.html" },
    { "source": "/aset-investasi", "has": [{ "type": "host", "value": "pundi.online" }], "destination": "/aset-investasi.html" },
    { "source": "/net-worth", "has": [{ "type": "host", "value": "pundi.online" }], "destination": "/net-worth.html" },
    { "source": "/trading-journal", "has": [{ "type": "host", "value": "pundi.online" }], "destination": "/trading-journal.html" },
    { "source": "/backup-keuangan", "has": [{ "type": "host", "value": "pundi.online" }], "destination": "/backup-keuangan.html" },
    { "source": "/kalkulator-net-worth", "has": [{ "type": "host", "value": "pundi.online" }], "destination": "/kalkulator-net-worth.html" },
    { "source": "/auth/reset-password", "destination": "/app.html" },
    { "source": "/auth/reset-password/", "destination": "/app.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://ndeycwoyjwyntjkgbzlz.supabase.co wss://ndeycwoyjwyntjkgbzlz.supabase.co; worker-src 'self' blob:; manifest-src 'self'" }
      ]
    }
  ]
}
