# Public Supabase configuration. VITE/PUNDI values are embedded at build time
# for Web/Android/Windows so market-data runtime does not need Vercel /api/config.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
PUNDI_SUPABASE_URL=
PUNDI_SUPABASE_ANON_KEY=

# Server-side values used by Vercel compatibility routes and Edge deployment.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only market data providers
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
STOCK_SYMBOL_ALLOWLIST=

# Optional server-only scheduled refresh
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Dedicated Pundi Telegram webhook (server-only)
TELEGRAM_CVFINANCE_BOT_TOKEN=
TELEGRAM_CVFINANCE_ALLOWED_USER_ID=
TELEGRAM_CVFINANCE_ALLOWED_CHAT_ID=
TELEGRAM_CVFINANCE_WEBHOOK_SECRET=
CVFINANCE_OWNER_USER_ID=
